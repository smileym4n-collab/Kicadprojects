	(text "Q4 drives K1..K3: ~101mA nominal; allow 120mA. Q5 drives K4/K5: ~68mA; allow 80mA.\nAll AGN2004H coils intentionally use +5R (4.5V nominal).\nR95 retains 1k fault-current limit; R93=100R increases Q5 base drive.\nU13: allow 2.7W; effective junction-to-ambient <=20 C/W. +15V source >=350mA."
		(exclude_from_sim no)
		(at 29.21 93.98 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "186b430b-3e1d-5a78-b95a-2c8bd5ffe494")
	)
	(text "Default: AV_ENABLE=0, RUN_REQUEST=0. Output stays muted until firmware sequence completed.\nRail interlock clamps RUN_HW independently; MCU requires fresh settling delay after fault."
		(exclude_from_sim no)
		(at 20.32 15.24 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "424b61ec-7aa9-5618-a65a-6605fe772c38")
	)
	(text "Optional open collector contact to GND. Assert before analog rails collapse.\nNO external voltage injection. Without early warning, arbitrary fast\npower loss cannot be guaranteed pop-free by a mechanical relay."
		(exclude_from_sim no)
		(at 36.322 170.688 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left top)
		)
		(uuid "e05546cc-cf6e-5155-abaa-8b529a1b7d13")
	)
	(text "RUN=0: Q6 OFF, Q7 ON => CS mute asserted.\nR97 uses +5A: loss of +5R still asserts mute while +5A lives.\nRUN=1: Q6 ON, Q7 OFF => CS_RUN high; no rail backfeed."
		(exclude_from_sim no)
		(at 264.16 179.07 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left top)
		)
		(uuid "f29e7910-05b6-502e-b404-9c389f83bd28")
	)

	(text "J26 shorts open-collector RAIL_GOOD to GND: hardware mute, independent of firmware.\nTP11 post-LPF; TP12 post-phase; TP13 post-subsonic; TP14 final output.\nUse GND TP7 as scope reference; never clip scope ground to an inactive RCA return."
		(exclude_from_sim no)
		(at 40.64 180.34 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left top)
		)
		(uuid "167efba9-444e-590b-af19-8afd9f775dc8")
	)
	(text "Rail comparators / external early power fail pull RAIL_GOOD low. ATtiny PB2 reads it independently of RUN_REQUEST.\nOn a fault: mute immediately in hardware; firmware clears RUN_REQUEST and waits 500ms stable RAIL_GOOD before rearm."
		(exclude_from_sim no)
		(at 20.32 20.32 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "1d3fcd9b-7d05-5494-8f22-6af9cb95c38b")
	)
	(text "Good rails: Q8 ON, Q9 OFF; firmware may release RUN.\nBad rails: Q8 OFF, Q9 ON; RUN_HW clamped, Q5 OFF, K4 shorts input to AMP_RETURN.\n+5R absent: all coils OFF; K4 shorts input to AMP_RETURN. No MCU instruction is required for this state."
		(exclude_from_sim no)
		(at 31.75 117.856 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "d8e6a4d7-70a4-5e9b-9d17-2a7ea8ae0d4d")
	)

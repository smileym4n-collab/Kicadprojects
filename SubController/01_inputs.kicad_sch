	(text "U2: caps physically at pins 8/4"
		(exclude_from_sim no)
		(at 292.1 241.3 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left top)
		)
		(uuid "05e2fe44-e172-5a0f-84a3-b44bcfe4d49b")
	)
	(text "U1: caps physically at pins 8/4"
		(exclude_from_sim no)
		(at 147.32 241.3 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left top)
		)
		(uuid "0a02cfe6-6f67-51a1-9307-f27b096af649")
	)
	(text "MONO = (10/22)(L+R); AV = (20/22)LFE, after differential receivers.\nNo direct L/R connection. Main speakers remain full range."
		(exclude_from_sim no)
		(at 245 180 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "267f0661-bf45-5cbd-bfd4-df74ad8507eb")
	)
	(text "U1 differential receivers: Vout = SIGNAL - SOURCE_RETURN (DC gain1).\n47k matched ratios; REF input ~94k/channel, LFE ~47k. Return is sensed, not bonded.\nC1/C64 and C2/C65: matched 100p C0G; differential RF pole ~33.9kHz.\n0.1% resistors; select capacitor pairs within 2% for common-mode rejection."
		(exclude_from_sim no)
		(at 246.38 114.3 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "4f310c0c-2c36-5c5d-b935-eedfd620ea4e")
	)
	(text "TP8/9: selected REF L/R buffers; both carry LFE in AV.\nProbe inactive RCA returns only with an isolated/differential instrument."
		(exclude_from_sim no)
		(at 20.32 180.34 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left top)
		)
		(uuid "6e7cab82-89cd-52a0-a826-c9e3fbf365e9")
	)
	(text "RCA shells MUST be insulated from plate/chassis. Inactive source has no bias / ESD path to board GND."
		(exclude_from_sim no)
		(at 20.32 15.24 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "9d7f5807-de7c-5a69-9511-a18e1248d2dc")
	)
	(text "NC = REFERENCE; energised = AV.\nK1/K2 switch while K4 muted. Coils on driver sheet."
		(exclude_from_sim no)
		(at 66.04 129.54 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left top)
		)
		(uuid "b3cf6f34-9a95-5fec-b9bb-2b065e6256db")
	)
	(text "K5 OFF grounds buffer inputs; powered sources are disconnected.\nK5 and K4 share RUN. Connect at CS code0, wait 2s, then fade up."
		(exclude_from_sim no)
		(at 92.71 150 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left top)
		)
		(uuid "beb70bd3-0a68-576d-90b7-c3dcc22ed30a")
	)
	(text "K2A selects SOURCE_RETURN for differential input sensing. K2B unused.\nReference L/R returns share REF_RETURN before the relay.\nNever bond SOURCE_RETURN to GND or chassis."
		(exclude_from_sim no)
		(at 40.64 162.56 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left top)
		)
		(uuid "deb38c8f-3e1f-5903-bad2-008d78334748")
	)

	(text "All audio stays analogue. MCU reset makes RUN and AV GPIO high impedance; external pull-downs drop relays.\nInternal clock; BOD and watchdog required. PA0 remains UPDI. No I/O expander or retained relay latch."
		(exclude_from_sim no)
		(at 20.32 25.4 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left top)
		)
		(uuid "3abf57da-ad03-59b5-886b-2bb73fff1916")
	)
	(text "Open/inactive=REF, active=AV. J24: 1-2 AUTO, open REF, 2-3 AV.\n12V trigger ~5mA; for 5V fit 750R. Trigger return stays isolated."
		(exclude_from_sim no)
		(at 252.73 203.2 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left top)
		)
		(uuid "54d79a05-99a2-5b99-81b4-904b972d1e88")
	)
	(text "Dry-contact encoders; software quadrature debounce.\nSeparate stored REF/LFE levels; never positive CS gain."
		(exclude_from_sim no)
		(at 160.02 127 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left top)
		)
		(uuid "8d985777-0c53-50d2-b70a-66e1e18be960")
	)
	(text "Serial collectors use +5A. 10kHz software clock, inverted GPIO. Default clock/data LOW, CS HIGH."
		(exclude_from_sim no)
		(at 20.32 279.4 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left top)
		)
		(uuid "95593bc0-caeb-511e-b38f-4f8256c62a65")
	)

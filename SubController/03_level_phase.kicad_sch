	(text "Panel pot: pin1 top; pin2 wiper; pin3 tied wiper (fail-safe full R).\nAt 70 Hz: -24 to -137 deg; use bypass for 0 deg. Not constant time delay."
		(exclude_from_sim no)
		(at 20.32 259.08 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "12aedc38-fe0e-5608-98ea-de3140f7f39c")
	)
	(text "DC/audio gain -0.5; R112 limits CS input fault current <7.2mA.\nR39 senses ATT_IN after R112; C62 provides local HF feedback.\nHF corner ~110.5kHz (10k CS load); output -2 restores level."
		(exclude_from_sim no)
		(at 132.08 101.6 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "69b6474d-3fd3-5012-9160-96fd70609090")
	)
	(text "K3 pole A bypasses ONLY the Reference low-pass in AV. Pole B selects AV HP configuration on next sheet."
		(exclude_from_sim no)
		(at 20.32 15.24 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "806c01b8-2230-5e62-88f6-2ba31761f85c")
	)
	(text "U6B isolates CS output from the HP / all-pass network.\nCS sees only op-amp input / short trace capacitance (<100pF)."
		(exclude_from_sim no)
		(at 127 172.72 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left top)

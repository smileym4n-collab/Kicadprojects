	(text "ESP32-WROVER-IE-N16R8: EXTERNAL ANTENNA"
		(exclude_from_sim no)
		(at 25.4 20.32 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left top)
		)
		(uuid "949741fb-b866-4ed5-98eb-144d63195807")
	)
	(text "Preserved: LED Wi-Fi=32, BT=33; LRCK=25, BCK=26, DIN=13; SCL=19, SDA=21.\nAdded: SDZ enable=27; MUTE command=23 (HIGH=mute); FAULTZ=35 (input only); DAC_XSMT=18.\nGPIO36 ADC1 monitors PVDD/11. GPIO0 BOOT pull-up; EN reset has 10k/1u RC.\nGPIO6-11 / GPIO16-17 reserved for internal flash/PSRAM: no external use.\nJ2: pins 2/3 go to ESP RX/TX (cross adapter TX/RX). Pin 6 is voltage reference only.\nDo not power the board through J2; adapter must use 3.3 V logic.\nModule custom pads 39-47 are segments of the common exposed GND area.\nFit a compatible external antenna to the IE module; keep RF connector/feed away from switch nodes."
		(exclude_from_sim no)
		(at 25.4 144.78 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "f36d9e4f-6f16-48bf-81c7-5248bc897e4f")
	)

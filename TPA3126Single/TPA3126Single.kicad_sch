	(text "12-16 V regulated DC.\n20 dB gain, stereo BTL.\nJ17 = LEFT, J16 = RIGHT.\nPin 1 = +, pin 2 = -.\nBoth speaker terminals are active."
		(exclude_from_sim no)
		(at 76.2 63.5 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "64e06b5c-00e0-4c88-b63c-ba8a07aa92a7")
	)
	(text "J2 pin 1 = LEFT, pin 2 = RIGHT, pin 3 = SIGNAL GND.\nFeed directly from a variable preamp, or use a panel-mounted\n10k dual-gang audio-taper pot ahead of J2.\nPer gang: source hot to CW, CCW to signal GND, wiper to J2."
		(exclude_from_sim no)
		(at 76.2 134.62 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "c49f465a-5fcf-47fc-8945-70720171ae4c")
	)

	(text "40 V single supply. AMP_OUT rests at ~20 V DC; SPK_OUT has DC blocked by C10.\nC10 positive faces amplifier; 4700u / 50V gives ~4.23 Hz into 8 ohm.\nVREF = filtered divider midpoint (~20 V); input/feedback only, never speaker return.\nC1 must remain fitted for a ground-referenced source; DC bypass R2 removed.\nC8/C9 filter VREF; C6/C7 bypass the 40 V supply. R10 changed to preserve bias.\nStartup/shutdown thump and reference settling require bench verification."
		(exclude_from_sim no)
		(at 30.48 426.72 0)
		(effects
			(font
				(size 1.25 1.25)
			)
			(justify left top)
		)
		(uuid "33f8f6e3-fbb1-45be-b429-540bd05c0fb1")
	)
	(text "FIRST-PASS LIMITS / BENCH TBC"
		(exclude_from_sim no)
		(at 236.22 406.4 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "38417cbc-a9f2-47e6-aa9a-794f2e701787")
	)
	(text "CURRENT MIRROR / VAS"
		(exclude_from_sim no)
		(at 190.5 58.42 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "46162a10-5330-4855-9500-1f2427561039")
	)
	(text "OUTPUT / SPEAKER"
		(exclude_from_sim no)
		(at 482.6 58.42 0)
		(effects

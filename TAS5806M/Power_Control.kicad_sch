		(title "Always-on domain: TPS7A2033 LDO, ATtiny412 power latch, encoder, UPDI")
		(date "2026-10-19")
		(rev "A")
		(company "TAS5806M Bluetooth soundbar")
		(comment 1 "OFF state: only BQ25895 (BATFET on), TPS7A2033 and sleeping ATtiny412 draw current (~40 uA typ)")
		(comment 2 "Short press = ON, hold >= 2 s = graceful OFF via ESP32, hold >= 12 s (no USB) = BQ25895 /QON hardware reset")
		(comment 3 "ATtiny pins: PA0 UPDI, PA1 EN_3V3, PA2 CHG_INT_N (async wake), PA3 BTN_N, PA6 TXD, PA7 RXD")

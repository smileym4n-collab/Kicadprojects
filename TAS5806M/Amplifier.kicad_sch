	(title_block
		(title "TAS5806M stereo Class-D (BTL), LC output filters, speaker outputs")
		(date "2026-10-19")
		(rev "A")
		(company "TAS5806M Bluetooth soundbar")
		(comment 1 "PVDD 9.3 V, hybrid modulation, Fsw 384 kHz (or 768 kHz 1SPW), AGAIN -10.5 dB, I2C address 0x2D (15k ADR)")
		(comment 2 "Filter per leg: 10 uH (Codaca CSAD0660-100M winding) + 0.68 uF to GND -> 61 kHz (TI SLASEP9 Table 53, Fig.114)")
		(comment 3 "BTL outputs: NEITHER speaker terminal is ground. Bootstraps 0.22 uF per TI 10.1.1")
	)

		(uuid "abf0c9d5-f563-43c5-866c-3c7324ce3457")
	)
	(text "Assembly option: fit EITHER this block (HIGH-LEVEL build) OR J1/J2/K2/K3 + drivers (LOW-LEVEL build). See Config field."

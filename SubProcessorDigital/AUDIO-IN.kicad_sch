	)
	(text "Higher-power amps: change Rf = Rg (and Cf = Cg) together: 6K8/6.8nF for 100 W, 4K7/10nF for 200 W into 8R. Rin stays 100K."
		(exclude_from_sim no)
		(at 22.86 281.94 0)
		(effects
			(font

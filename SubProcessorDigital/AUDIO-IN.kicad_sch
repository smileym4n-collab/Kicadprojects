		(uuid "aafe7607-0168-4292-b4ed-6962f6436232")
	)
	(text "Common mode: matched 100K/10K pairs; worst-case CMRR ~35 dB with 0.5 % 100K (0.1 % 100K -> ~49 dB). Cf/Cg remove Class-D residue."
		(exclude_from_sim no)
		(at 22.86 279.4 0)
		(effects

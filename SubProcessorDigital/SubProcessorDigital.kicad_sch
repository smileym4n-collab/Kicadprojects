	(paper "A3")
	(title_block
		(title "P68 Subwoofer DSP Controller")
		(date "2026-10-14")
		(rev "A")
		(company "SubProcessorDigital")
		(comment 1 "PCM1863 ADC -> ESP32-S3 IIR DSP -> PCM5102A DAC -> protected output relay -> ESP P68")
		(comment 2 "Schematic completed/reviewed 2026-10-14: not yet bench tested; PCB not laid out")
	)
	(lib_symbols)
	(text "DESIGN NOTES (full engineering report: SubProcessorDigital/DESIGN_REVIEW.md)"
		(exclude_from_sim no)
		(at 25.4 205.74 0)
		(effects
			(font
				(size 1.5 1.5)
				(bold yes)
			)
			(justify left)
		)
		(uuid "25edc33e-3479-4c93-abf8-b82022074eac")
	)
	(text "Power: +15 V -> 1N5819 -> LMR51430 (500 kHz FPWM) -> +5 V -> TPS7A2033 x4 (DAC, ADC-A, ADC-D, UI) + TS1117B (ESP32)."
		(exclude_from_sim no)
		(at 25.4 228.6 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "3c2c2bc2-540c-412d-9743-677aa35be3a1")
	)
	(text "Clocks: ESP32-S3 I2S0 master, full duplex: BCK 3.072 MHz, LRCK 48 kHz. PCM1863 and PCM5102A both use internal BCK-PLLs."
		(exclude_from_sim no)
		(at 25.4 213.36 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "42065a03-5df5-47b3-8d70-b627a9fdc511")
	)
	(text "  1-2 blocks + DAC low-latency 3.5/fs. With 32-frame blocks at 48 kHz ~ 2.3-3.0 ms; 16-frame ~ 1.3-1.6 ms. MEASURE."
		(exclude_from_sim no)
		(at 25.4 220.98 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "4a80c92b-73ec-48f4-92e1-1747d9f6e7ac")
	)
	(text "  IO48 ADC_INT.  IO35/36/37 unused (PSRAM on N8R8).  IO0 BOOT.  Wi-Fi/BT unused (U.FL left open)."
		(exclude_from_sim no)
		(at 25.4 243.84 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "6572116e-e2c4-4473-8e7b-69754f6e492a")
	)
	(text "  IO38 I2S DOUT, IO39/40/41 ENC3 A/B/SW, IO42 FAULT_N in, IO43/44 UART0, IO45 INPUT_SEL, IO46 STATUS_LED, IO47 MODE_TRIG_N,"
		(exclude_from_sim no)
		(at 25.4 240.03 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "951cf24c-6c10-423f-a4c1-352b877a53ff")
	)
	(text "Latency (fixed, excl. filter group delay): ADC low-latency IIR 10/fs + DMA in 1 block + processing 1 block + DMA out"
		(exclude_from_sim no)
		(at 25.4 217.17 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "adef334b-e227-4f6c-9e0a-865068c286ea")
	)
	(text "Protection: K1 energises only with latch Q (cleared by any supervisor/watchdog/power fault) AND AUDIO_READY level."
		(exclude_from_sim no)
		(at 25.4 224.79 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "b4162ee8-9f64-4167-9f4d-3160f825c600")
	)
	(text "GPIO: IO1 XSMT, IO2 WDI, IO3 RLY_SENSE, IO4/5/6 ENC1 A/B/SW, IO7 I2S DIN, IO8 ENC2 SW, IO9 MCLK(opt), IO10 BCK, IO11 LRCK,"
		(exclude_from_sim no)
		(at 25.4 232.41 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "d52e9c56-5f73-4b3f-bb63-0b409a0c2e79")
	)
	(text "  IO12/13 I2C0 SDA/SCL (ADC), IO14/21 I2C1 SDA/SCL (UI), IO15/18 ENC2 A/B, IO16 AUDIO_READY, IO17 VBUS sense, IO19/20 USB,"
		(exclude_from_sim no)
		(at 25.4 236.22 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "e4e84f0c-34eb-40c2-b767-6b9878a5ad79")
	)
	(text "Signal: preamp L/R or Marantz LFE -> K2/K3 relays (signal AND source-ground switched) -> 4k7 -> 10u NP -> 100R/10n -> PCM1863."
		(exclude_from_sim no)
		(at 25.4 209.55 0)

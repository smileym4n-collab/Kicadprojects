	(text "L CHANNEL - INDEPENDENT GALVANIC ISOLATION"
		(exclude_from_sim no)
		(at 20.32 17.78 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "289e23dc-3495-444e-8316-2e08ffee72d1")
	)
	(text "Nominal midband input impedance ~570k. AC gain ~101 x 100/570 = 17.7.\nNominal trigger ~4mVrms at 1kHz; tuning/bench value, not a guaranteed noise threshold.\nAt 2Vrms the detector saturates intentionally; it is outside the through audio path.\n470k limits loading when unpowered. Design input: up to 2Vrms sine (2.83V peak)."
		(exclude_from_sim no)
		(at 157.48 248.92 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "67b8f403-e939-4364-ab09-2e99d67e78df")
	)
	(text "Isolated return is tied ONLY to SEL_L_RETURN, after its source-selection relay.\nNo detector wire, resistor, capacitor or shield connects this return to control GND or the other channel."
		(exclude_from_sim no)
		(at 20.32 30.48 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "95e8b46f-05d0-4dd5-91a4-eca8a3aa1a4d")
	)
	(text "CONTROL SIDE"
		(exclude_from_sim no)
		(at 342.9 200.66 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "b61bae6a-4250-48f7-9d78-8ddda98162e1")
	)
	(text "Branch clamps only;\nnever in the main audio path."
		(exclude_from_sim no)
		(at 20.32 261.62 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "bb007839-48ab-44b4-bdfa-3fb228da508f")
	)
	(text "30R preload: ~167mA / 0.83W at 5V. Use 3W flameproof; keep clear of capacitors.\n100R + 47u filters switching ripple. Bias ~1.1V; LM358 retained.\nSPU03 INPUT IS 5V ONLY. Check isolated raw rails 4-6V and quiet rails >=3.6V."
		(exclude_from_sim no)
		(at 20.32 134.62 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)

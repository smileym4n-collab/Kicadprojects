	(text "Branch clamps only;\nnever in the main audio path."
		(exclude_from_sim no)
		(at 20.32 261.62 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "2280a27b-2cdb-4fbb-bf94-0f3d5cb2fbb7")
	)
	(text "Optocoupler collector is the only\nlogic interface. Both channels\nwire-OR into one active-low input."
		(exclude_from_sim no)
		(at 330.2 213.36 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "3503c69f-79fa-460b-9ad0-15ee09471e84")
	)
	(text "Isolated return is tied ONLY to SEL_R_RETURN, after its source-selection relay.\nNo detector wire, resistor, capacitor or shield connects this return to control GND or the other channel."
		(exclude_from_sim no)
		(at 20.32 30.48 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "35eba016-f7d1-4bfd-ac5d-7c5c829ee40c")
	)
	(text "CONTROL SIDE"
		(exclude_from_sim no)
		(at 342.9 200.66 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "6f03b139-43b5-4344-b9b4-1e65616beacb")
	)
	(text "R CHANNEL - INDEPENDENT GALVANIC ISOLATION"
		(exclude_from_sim no)
		(at 20.32 17.78 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "713143fe-e35e-4527-aea2-77bd4eaa3de5")
	)
	(text "Nominal midband input impedance ~570k. AC gain ~101 x 470/570 = 83.3.\nNominal trigger ~4mVrms at 1kHz; tuning/bench value, not a guaranteed noise threshold.\nAt 2Vrms the detector saturates intentionally; it is outside the through audio path.\n100k limits loading when unpowered. Only ordinary SELV signals belong here."
		(exclude_from_sim no)
		(at 157.48 248.92 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "bddee84c-f76b-4ce6-8e18-0e4e86ebdba7")
	)
	(text "1k2 preload holds the isolated converter above 10% load.\n100R + 47u filters its switching ripple. No capacitor crosses isolation.\nModule input range 10.8-13.2V: verify at the protected +12V rail."
		(exclude_from_sim no)
		(at 20.32 134.62 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "f360026f-1816-44c2-bf3b-65d2207a631b")
	)

	(text "1k2 preload holds the isolated converter above 10% load.\n100R + 47u filters its switching ripple. No capacitor crosses isolation.\nModule input range 10.8-13.2V: verify at the protected +12V rail."
		(exclude_from_sim no)
		(at 20.32 134.62 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "15e76028-a205-4c5c-9512-789f497f60b6")
	)
	(text "Nominal midband input impedance ~570k. AC gain ~101 x 470/570 = 83.3.\nNominal trigger ~4mVrms at 1kHz; tuning/bench value, not a guaranteed noise threshold.\nAt 2Vrms the detector saturates intentionally; it is outside the through audio path.\n100k limits loading when unpowered. Only ordinary SELV signals belong here."
		(exclude_from_sim no)
		(at 157.48 248.92 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "35206000-4cfc-41a2-9895-1dd595aaf7c4")
	)
	(text "Optocoupler collector is the only\nlogic interface. Both channels\nwire-OR into one active-low input."
		(exclude_from_sim no)
		(at 330.2 213.36 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "3e18b28d-feb6-4d20-ad08-6d760e55adbe")
	)
	(text "L CHANNEL - INDEPENDENT GALVANIC ISOLATION"
		(exclude_from_sim no)
		(at 20.32 17.78 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "721092b9-4717-42b9-b516-7c5d43127637")
	)
	(text "Branch clamps only;\nnever in the main audio path."
		(exclude_from_sim no)
		(at 20.32 261.62 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "80f93386-b231-4358-a084-e998c7dfac19")
	)
	(text "CONTROL SIDE"
		(exclude_from_sim no)
		(at 342.9 200.66 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "dc048503-571b-4d62-a257-ce637fee8439")
	)
	(text "Isolated return is tied ONLY to SEL_L_RETURN, after its source-selection relay.\nNo detector wire, resistor, capacitor or shield connects this return to control GND or the other channel."
		(exclude_from_sim no)
		(at 20.32 30.48 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "e990c222-21cd-4c0f-b108-590feea03000")
	)

		(uuid "2ea8d4ce-c4e2-4b85-b770-8d6ae80af23a")
	)
	(text "5V supply: 500mA capacity; 3 relay coils total about 63mA nominal.\nAllow 100mA total 5V load, plus two isolated detector modules on 12V.\nR-78E total output capacitance must stay below 220uF.\nInput TVS/fuse coordination and ripple/EMI need bench/layout validation."
		(exclude_from_sim no)
		(at 205.994 134.62 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "30334fae-de50-410a-a63d-dba2d20efc9c")
	)
	(text "DC input only. G7L mains contacts and all 230V wiring are chassis-mounted off-board.\nPE remains continuous and is never switched. Supply GND is the controller ground only."
		(exclude_from_sim no)
		(at 20.32 33.02 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "524b4e7e-ac21-4e7c-9379-db1cfa88751f")
	)
	(text "D1 reverse-polarity blocking; F1 limits fault current; D2 clamps short input transients.\nNot a sustained-overvoltage disconnect. Use only the specified regulated adapter.\nSS14 drop reduces the coil/module feed slightly below the adapter voltage."
		(exclude_from_sim no)
		(at 35.306 138.43 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "7de5c459-a92e-4be5-806c-f51e15364483")
	)

	)
	(text "CLK_SEL  LOW = CLK0 = 22.5792 MHz (44.1 / 88.2 kHz)     HIGH = CLK1 = 24.576 MHz (48 / 96 kHz)\nPolarity is identical to the original 74LVC1G157 board (GPIO7 LOW = 22.5792 MHz). 10k pull-down = 22.5792 MHz during MCU reset."
		(exclude_from_sim no)
		(at 25.4 21.59 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "34825728-f4f2-52df-bfaa-a61ed8dad910")
	)
	(text "SFOUT[1:0] = 1,1 -> LVCMOS 12 mA (as fitted)\nOther options (Si5330x Table 2.4): 0,1 = 24 mA   1,0 = 18 mA   open,0 = 6 mA (Rs = 0R)\nNever fit both resistors on one SFOUT pin."
		(exclude_from_sim no)
		(at 307.34 175.26 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "362dbac6-e44a-5f83-933c-c0f1fa1ff9a9")
	)

		(uuid "660380b0-944a-56c7-8077-7ab9928081b4")
	)
	(text "ISOLATED VBUS DETECT (config A): V1OK is HIGH only while side 1 (VBUS) is above its UVLO.\nPush-pull from 3V3_ISO, active HIGH - same polarity as config B."
		(exclude_from_sim no)
		(at 283.972 124.968 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "6df0bd6a-a8db-5663-834e-8363750066ff")
	)
	(text "CONFIG A - ISOLATED (as drawn): ISOUSB211 + all its decoupling + 3V3_ISO LDO fitted; UD/DD 0R links fitted; V1OK link fitted.\n                   BYPASS links, GROUND BRIDGE, VBUS divider + Schmitt buffer NOT fitted.\nCONFIG B - NON-ISOLATED: ISOUSB211, its decoupling and the 3V3_ISO LDO NOT fitted; 4 x BYPASS 0R + 2 x GROUND BRIDGE 0R fitted;\n                   VBUS divider + Schmitt buffer + its link fitted.  Never fit both link sets.\nUSB VBUS is never connected to the local 5 V rail.  Functional isolation only - not a safety barrier."
		(exclude_from_sim no)
		(at 25.4 21.59 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "6e3f8a99-1b61-57fe-87fb-77c57501b197")
	)
	(text "Ground symbols on this sheet:  thick bar = GND_USB (USB host side)     triangle = GND (local / audio side)"
		(exclude_from_sim no)
		(at 25.4 43.18 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "942307b9-f99d-5049-9ab4-be527ebe7fb7")
	)
	(text "GROUND BRIDGE (config B only)"
		(exclude_from_sim no)
		(at 140.97 152.77 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "9d35dd54-327e-5563-8026-a3c9891286e9")
	)
	(text "NON-ISOLATED VBUS DETECT (config B only)\n33k / 47k divider -> Schmitt buffer (VT+ <= 2.1 V at pin = 3.6 V at VBUS).\nDivider returns to local GND: valid only with the ground bridge fitted.\nAll parts DNP when isolated - nothing resistive crosses the barrier."
		(exclude_from_sim no)
		(at 114.3 188.722 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)

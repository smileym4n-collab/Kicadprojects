	(text "5 V BUCK  (feeds ESP32 LDO + DAC LDO)"
		(exclude_from_sim no)
		(at 104.14 99.06 0)
		(effects
			(font
				(size 2 2)
				(thickness 0.254)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "3e6a639b-090e-4553-bdad-08dd44a91f2a")
	)
	(text "LMR51430XF: forced PWM, 500 kHz (450-560 kHz), no PFM bursts in the audio band.\nVout = 0.6 V x (1 + 100k/13.7k) = 4.98 V.   EN tied to VIN (internal UVLO 4.5 V).\nFirmware must assert DAC_XSMT low then AMP_RESET_N low when VIN_SENSE\nfalls (~9.5 V), before TPA3220 UVP (6.4 V).  L1 ripple ~1.0 A p-p at 16 V in; peak IL ~1.1 A."
		(exclude_from_sim no)
		(at 104.14 134.62 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "50fdf4d2-cac5-46c8-b4fa-4d1c6ebaf886")
	)
	(text "INPUT PROTECTION"
		(exclude_from_sim no)
		(at 22.86 33.02 0)
		(effects
			(font
				(size 2 2)
				(thickness 0.254)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "540bb65e-16f4-461c-b6a2-925ac08a9f9e")
	)
	(text "3V3 LDO  (ESP32 only)"
		(exclude_from_sim no)
		(at 104.14 149.86 0)
		(effects
			(font
				(size 2 2)
				(thickness 0.254)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "9e2723d8-1b78-4180-b012-cdee6f126d6c")
	)
	(text "J1: 12-16 V DC from panel-mounted jack (pin 1 = +, pin 2 = GND).\nF1 5 A time-lag. Q1 high-side P-FET: blocks reverse polarity; body diode starts it,\nthen VGS = -VIN via R22. D1 clamps VGS (DMP4015SK3 VGS max +/-25 V).\nD2 SMAJ18A: VWM 18 V, VC 29.2 V max - below TPA3220 PVDD abs max (37 V),\nLMR51430 VIN abs max (38 V) and the 35 V bulk electrolytics.\nPVDD/11 -> VIN_SENSE (ESP32 GPIO36) for power-fail detection."
		(exclude_from_sim no)
		(at 22.86 80.01 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "a47bd558-cdc5-48cc-b581-be64658af952")
	)
	(text "TLV1117LV33: 1 A, Vdo 0.455 V @ 1 A.\nPdiss ~0.3 W avg (180 mA), 0.85 W bursts.\nSOT-223 tab to copper (RthJA 63 C/W).\nESP32 22 uF + 100 nF on ESP32 sheet."
		(exclude_from_sim no)
		(at 104.14 154.94 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "e78cb111-21c6-4fc9-9edc-df23d8e2e8bc")
	)

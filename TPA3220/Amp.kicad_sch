	(text "L6/L7 CODACA CSAD0660-100M: winding 1-2 and 4-3. Codaca does not\npublish dot polarity; the KiCad L_Coupled symbol dots are generic.\nVERIFY on a sample before layout: short pins 2-3, measure L(1-4).\n~2x L(1-2) = uncoupled, >2x = aiding (OK), <<2x = opposing (re-wire)."
		(exclude_from_sim no)
		(at 165.1 147.32 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "28e6a7fa-6c22-44c1-a786-b645ad2c6d66")
	)
	(text "Stereo BTL, AD modulation (HEAD = 0), master (OSCM/OSCP open),\ngain 18 dB (GAIN/SLV 5.6k to GND, latched on RESET rising edge),\nfPWM 600 kHz nominal (FREQ_ADJ 49.9k).  Input impedance 48k:\n1 uF coupling -> 3.3 Hz HPF.  Single-ended: INx_M is AC-grounded\nat the top level - route its GND end back to the DAC output ground.\nSupplies: VDD = PVDD, internal LDO -> AVDD (1 uF), GVDD via 3R3/1 uF.\nAVDD must not power external circuits (TI 10.2.1.2).\nAmplifier INVERTS: OUTx_M is in phase with the DAC output, so\nJ16/J17 pin 1 (via OUTx_M) = SPEAKER +.  Neither speaker pin is GND.\nCH1 (IN1, J16) = WOOFER (DAC OUTL).  CH2 (IN2, J17) = TWEETER (DAC OUTR).\nRESET_N held low by R36 until the ESP32 has configured the PCM5122.\nFAULT_N / OTW_CLIP_N open drain (internal 26k to 3.3 V, off in reset):\nexternal 10k pull-ups on the ESP32 sheet."
		(exclude_from_sim no)
		(at 165.1 111.76 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "40361845-b874-43c8-ab24-f8c7668103bd")
	)
	(text "PVDD BULK: C55 at pins 29-31,\nC56 at pins 36-38"
		(exclude_from_sim no)
		(at 45.72 167.64 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "707217cf-2aee-4142-8daa-264739ebc30a")
	)
	(text "TPA3220 CONFIGURATION"
		(exclude_from_sim no)
		(at 165.1 106.68 0)
		(effects
			(font
				(size 2 2)
				(thickness 0.254)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "9f3c2320-f5ab-4186-bddf-89992e2e5a19")
	)
	(text "TPA3220 AVDD / GVDD  (internal LDO, VDD = PVDD)"
		(exclude_from_sim no)
		(at 93.98 160.02 0)
		(effects
			(font
				(size 1.524 1.524)
				(thickness 0.254)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "b034f215-5de5-4136-bf71-cacb56b9aaea")
	)

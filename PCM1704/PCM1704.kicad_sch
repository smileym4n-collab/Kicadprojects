	(text "SOFTWARE MODE (MODE=+5VDF): unused strap inputs tied to GND.\nPA4 -> DF_RST: 10k pull-down holds reset until MCU release.\nWait for stable rails and valid MCLK; release RST; wait >=1024 MCLK cycles.\nThen program 24-bit input/output, I2S, sharp roll-off; de-emphasis off.\nMute during initialisation and clock/sample-rate changes.\nA fixed startup delay is not a replacement for rail/clock fault detection."
		(exclude_from_sim no)
		(at 15.24 150 0)
		(effects
			(font
				(size 1.05 1.05)
			)
			(justify left top)
		)
		(uuid "516ae92f-c348-4f50-b7e8-488ba4eef23f")
	)

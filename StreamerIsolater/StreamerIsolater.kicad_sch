	(text "C36 at U1 pin 5 VCC1 -> pin 3 GND1; C37 at U1 pin 24 VCC2 -> pin 26 GND2\n(per ISOUSB211DPEVM C22/C31). Smallest loop, no vias."
		(exclude_from_sim no)
		(at 180.34 250.825 0)
		(effects
			(font
				(size 1 1)
			)

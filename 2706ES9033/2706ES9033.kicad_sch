	(text "U3 holds DAC_EN low until the PCM2706 3V3 rail is up and MCLK is stable,\nthen CHIP_EN high, wait 100 ms, clock setup at 0x98, then config at 0x90.\nPA6 senses the PCM2706 rail (3V3) via R25.  PA3 spare."
		(exclude_from_sim no)
		(at 116.84 271.78 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "271b9c3f-fb02-45c8-bf8a-0af97c5b0619")
	)
	(text "J4: 1=LEFT  2=GND  3=RIGHT (ch1=L, ch2=R)\nNT1 sits at J4 pin 2 = star point:\nroute GND_SNS as its own trace from U2 pin 7.\nC33/C34 GND also at the star point."
		(exclude_from_sim no)
		(at 289.56 184.15 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "40ccd484-514b-43fd-a220-ed99ad4e8f87")
	)
	(text "U2 straps: MODE=GND -> I2C,  ADDR1/ADDR0=GND -> 0x90 (0x98 sync)\nRT1 must be tied to DGND"
		(exclude_from_sim no)
		(at 185.42 264.16 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "5353dfaa-d34d-4b2b-a778-010da765798b")
	)

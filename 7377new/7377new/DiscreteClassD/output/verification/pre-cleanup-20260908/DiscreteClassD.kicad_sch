	)
	(text "U1A: LEFT input follower\nU1B: RIGHT input follower\nU3A: VREF_2V5 buffer\nU3B: shared triangle integrator\n\nU7A: oscillator Schmitt comparator\nU7B: LEFT PWM comparator\nU8A: RIGHT PWM comparator\nU8B: spare; inputs tied, output open\n\nU4 / U5: LEFT inverter / dual Schmitt buffer\nU9 / U10: RIGHT inverter / dual Schmitt buffer\nU11: +24V to +12V_GD TPS7A4901\nU12: +24V to +5V_A TPS7A4901\n\nU2 / U6: LEFT UCC27301A gate drivers\nU102 / U106: RIGHT UCC27301A gate drivers\n\nTotal: 14 IC packages, 8 power MOSFETs."
		(exclude_from_sim no)
		(at 619.76 116.84 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "44ed3c8e-d3d6-4cb5-843c-60b98c69e890")
	)

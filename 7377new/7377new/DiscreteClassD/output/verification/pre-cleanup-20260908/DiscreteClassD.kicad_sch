	(text "Enable defaults LOW. Fit DNP 1k only for standalone enable.\n100n here belongs to U4; Schmitt package bypass is in IC POWER row."
		(exclude_from_sim no)
		(at 17.78 518.16 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "91217dca-6aa2-4bfd-b8b9-8a531693b966")
	)
	(text "DEAD TIME TUNE - 330R / 100pF, tau = 33 ns.\nDiode K at source, A at RC: slow rise / fast fall.\n20-30 ns is a tuning target, not a guaranteed dead time."
		(exclude_from_sim no)
		(at 312.42 457.2 0)
		(effects
			(font
				(size 1.05 1.05)
			)
			(justify left top)
		)
		(uuid "9bb844bc-4178-45a1-a1b4-3adbf3bbd345")
	)
	(text "Vout = 1.185 x (1 + Rtop/Rbottom)\n5.0007 V nominal; divider current 118.5 uA\nEN tied to IN; DNC pin 7 left open; EP to PGND."
		(exclude_from_sim no)
		(at 416.56 111.76 0)
		(effects
			(font
				(size 1.05 1.05)
			)
			(justify left top)
		)
		(uuid "b029bf3e-6b2f-4aa4-9445-548a94eb91ef")
	)
	(text "Positive-feedback Schmitt: triangle -> 10k -> IN+; OUT -> 49k9 -> IN+; IN- = VREF.\nInverting integrator: square -> 3k09 -> IN-; 1nF from OUT to IN-; IN+ = VREF.\nIdeal 403.722 kHz; 1.9993 to 3.0014 V at nominal 5.0007 V rail. Tune / measure."
		(exclude_from_sim no)
		(at 218.44 210.82 0)
		(effects
			(font
				(size 1.05 1.05)
			)
			(justify left top)
		)
		(uuid "b09d9541-61b4-4722-8d22-b52bc34ceef5")

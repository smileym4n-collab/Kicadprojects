	(text "Bridge A: HI = DRIVE_P, LI = DRIVE_N.\nBridge B: HI = DRIVE_N, LI = DRIVE_P.\nENABLE drives both EN pins. Defaults LOW on main.\n+24V / +12V_GD / PGND are global.\nSpeaker and switch nets remain local to this channel.\nPGND is the single board-wide 0 V reference."
		(exclude_from_sim no)
		(at 274.32 214.63 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "8c27eade-e958-4c9d-b058-eed7aac00425")
	)
	(text "Local 24 V power loop ceramics"
		(exclude_from_sim no)
		(at 281.94 127 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "8fe936d6-f867-42a8-bb5f-5ad128242c83")
	)
	(text "HB flags represent charging through each UCC27301A internal bootstrap diode."
		(exclude_from_sim no)
		(at 182.88 281.94 0)
		(effects
			(font
				(size 0.9 0.9)
			)
			(justify left top)
		)
		(uuid "9e8c03d3-223e-4ec5-a370-c7c169bdb30e")
	)
	(text "HS / VSS: Kelvin returns to respective MOSFET sources.\nComplementary DRIVE_P / DRIVE_N include external dead time.\nDNP diode cathode faces driver: optional faster turn-off path."
		(exclude_from_sim no)
		(at 220.98 186.69 0)
		(effects
			(font
				(size 1.05 1.05)
			)
			(justify left top)
		)
		(uuid "a44cb7fc-651f-4624-ba8d-d77c60d8c5c1")
	)

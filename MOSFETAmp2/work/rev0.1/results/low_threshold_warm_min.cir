MOSFETAmp2 low_threshold_warm_min - approximate models
.include channel.cir
.param RV=2000 VTON=1.808 VTOP=-1.808 KPN=16.00987414603376 KPP=5.659490510622934 TS=75 TD=75
VP VP 0 {VS}
VN VN 0 {-VS}
VIN IN 0 DC 0 AC 1
XA IN OUT VP VN 0 AMP
LOUT OUT SPK 0.7u
RLDCR OUT SPK 10
RL SPK 0 8

.options reltol=1e-5 abstol=1e-10 vntol=1e-7
.control
set noaskquit
set wr_singlescale
set wr_vecnames
op
print v(out) v(xa.sn) v(xa.sp) v(xa.gn) v(xa.gp) v(xa.bp) v(xa.bn) i(vp) i(vn) v(xa.tail) v(xa.ve)
quit
.endc
.end

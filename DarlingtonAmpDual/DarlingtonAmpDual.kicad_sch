		(uuid "ded32155-e3fd-48e4-854e-c5aa1a45c4e7")
	)
	(text "DARLINGTON OUTPUT"
		(exclude_from_sim no)
		(at 306.07 35.56 0)
		(effects
			(font
				(size 1.35 1.35)
			)
			(justify left top)
		)
		(uuid "ef5906a5-fd40-4524-9beb-08ab3bb1878d")
	)
	(text "RV1: preset maximum resistance 1-3\n(wiper 2 tied to 3) for minimum bias.\nLost wiper -> LOW bias; track-open\nshunt -> lower still. R14/R15 failure\nis not made fail-safe.\nVspread ~1.6-3.4V + base-current term;\nactual Iq range / tracking TBC."
		(exclude_from_sim no)
		(at 224.79 180.34 0)
		(effects
			(font
				(size 1.15 1.15)
			)
			(justify left top)
		)

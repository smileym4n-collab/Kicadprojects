	)
	(text "C4 Miller (100p start), C3 lead (DNP), R8/R13 current, RV1 bias.\nCheck square-wave response with 8R / 4R / capacitive loads.\nCheck offset, startup, clipping recovery and heatsink bias tracking.\nNo DC protection, current limiting or thermal protection in Rev A.\nAt +/-35V a single pair is NOT signed off for sustained 4R use.\nWorst resistive Class-B dissipation ~15.5W/device (8R),\n~31W/device (4R), plus bias and reactive-load stress.\nSmall-signal leadforms and all exact passive/connector packages TBC.\nBD139 symbol uses onsemi ECB pin map; verify any stocked ST part\nindependently (ST legacy internal schematic numbering conflicts)."
		(exclude_from_sim no)
		(at 236.22 214.63 0)
		(effects
			(font
				(size 1.15 1.15)
			)
			(justify left top)
		)
		(uuid "504da7c7-502c-4793-80eb-ff983276b590")
	)
	(text "INPUT"
		(exclude_from_sim no)
		(at 17.78 35.56 0)
		(effects
			(font
				(size 1.35 1.35)
			)
			(justify left top)
		)
		(uuid "552be476-283d-48e2-ba4e-67ff260fa7c5")
	)
	(text "IREF ~-33.8V. Tail ~1.8mA; VAS ~6mA.\nR8/R13 TUNE: diode and VBE spread matter.\nQ1/Q2 collectors ~+33V, emitters ~-0.7V.\nQ5 ~60mW; front-end VCEO rating 120V.\nMedium-power Q8/Q10 rated 230V."
		(exclude_from_sim no)
		(at 154.94 271.78 0)
		(effects
			(font
				(size 1.15 1.15)
			)
			(justify left top)
		)
		(uuid "65b40881-304a-42e5-bb62-f430b7c988ff")
	)
	(text "BIAS SPREADER"
		(exclude_from_sim no)
		(at 232.41 35.56 0)
		(effects
			(font
				(size 1.35 1.35)
			)
			(justify left top)
		)
		(uuid "6ae6fe37-6e13-40aa-a700-0ca0d0ba389b")
	)
	(text "ONE MONO CHANNEL - DISCRETE CLASS AB / +/-35 V"
		(exclude_from_sim no)
		(at 16.51 15.24 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left top)
		)
		(uuid "6b7fb75b-883f-4903-9a03-5d6418c2f8df")
	)
	(text "One electrical GND net. Local star/reference at J2 pin 2.\nInput + feedback returns form quiet branches to that point.\nSpeaker, Zobel and decoupling returns use separate power paths.\nGeneric connector and passive footprints are TBC before layout.\nJ2/J3: select >=10A rated terminals; no series chosen yet."
		(exclude_from_sim no)
		(at 16.51 266.7 0)
		(effects
			(font
				(size 1.15 1.15)
			)
			(justify left top)
		)
		(uuid "84e285a1-76cc-4688-8e8d-e293e4a7487b")
	)
	(text "Feedback / Zobel at AMP_OUT.\nSpeaker connector after L1.\nSpeaker return / Zobel return\nroute separately to local star.\nNominal ~30-31Vpk -> 56-60W/8R;\nrail sag / clipping must be measured."
		(exclude_from_sim no)
		(at 369.57 214.63 0)
		(effects
			(font
				(size 1.15 1.15)
			)
			(justify left top)
		)
		(uuid "88a2ce65-8bde-4472-be15-908268a60aba")
	)
	(text "EXTERNAL POWER / LOCAL DECOUPLING"
		(exclude_from_sim no)
		(at 16.51 205.74 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left top)
		)
		(uuid "8d2b0c21-f90c-4065-84fc-0db84cde2674")
	)
	(text "BIAS TARGET: 80-100mA per device.\nN: TP1(+) to TP3(-): 17.6-22mV.\nP: TP3(+) to TP2(-): 17.6-22mV.\nBD139 on main heatsink; check warm drift.\nOutputs idle ~2.8-3.5W EACH.\nTO-3P: 1=B / 2=C / 3=E; tabs live.\n4 ohm SOA / cooling NOT qualified."
		(exclude_from_sim no)
		(at 317.5 214.63 0)
		(effects
			(font
				(size 1.15 1.15)
			)
			(justify left top)
		)
		(uuid "a062cb3f-6a19-40c8-9b5c-e366542ecec9")
	)
	(text "DC input link fitted. Zin ~22k.\nAudio gain 20.13 (26.1dB); DC gain 1.\nC2 is bipolar: no fixed DC polarity.\nQ1/Q2: match and thermally pair."
		(exclude_from_sim no)
		(at 16.51 148.59 0)
		(effects
			(font
				(size 1.15 1.15)
			)
			(justify left top)
		)
		(uuid "cc2b493e-bb9e-4812-a9e8-c9d57a605f26")
	)
	(text "DIFFERENTIAL / MIRROR"
		(exclude_from_sim no)
		(at 88.9 35.56 0)
		(effects
			(font
				(size 1.35 1.35)
			)
			(justify left top)
		)
		(uuid "d35605ad-1173-4391-bdc5-6bcb72d64ffb")
	)
	(text "REV A: FIRST SCHEMATIC FOR ENGINEERING REVIEW. 8 ohm target; 4 ohm capability needs SOA/thermal qualification."
		(exclude_from_sim no)
		(at 16.51 21.59 0)
		(effects
			(font
				(size 1.15 1.15)
			)
			(justify left top)
		)
		(uuid "d7bbe783-06a1-4684-932a-26f0c545391b")
	)
	(text "TAIL / VAS CURRENT REFERENCE"
